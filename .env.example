# Copy this file to .env and fill in real values.
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
# Deployment environment. dev / development / local / test = development
# mode (insecure settings only warn, /docs on, email restricted to
# EMAIL_ALLOWED_DOMAINS). Set APP_ENV=production in EVERY real deployment:
# the API then refuses to start with CORS_ORIGINS=*, an invalid origin or a
# weak JWT_SECRET, hides /docs, /redoc, /openapi.json and sends HSTS.
APP_ENV=production
# Exact browser origins of the HRMS web app(s), comma-separated, scheme +
# host [+ port], no path / trailing slash / wildcard. (* is refused when
# APP_ENV=production unless CORS_ALLOW_WILDCARD=true.) Local dev example:
# CORS_ORIGINS=http://localhost:8090,http://127.0.0.1:8090
CORS_ORIGINS=https://hrms.example.com,https://admin.hrms.example.com
CORS_ALLOW_WILDCARD=false
# Interactive API docs; unset = on only in development mode.
# API_DOCS_ENABLED=false
DEFAULT_COMPANY_NAME=impacgo people

# Secret used to sign login session tokens (HS256 JWT). Falls back to an
# insecure dev default if unset -- always set a real random value in any
# environment other than local dev.
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRE_MINUTES=480

# Microsoft Graph email (preferred transport; see docs/MICROSOFT_GRAPH_EMAIL.md).
# Microsoft Entra app registration with the Microsoft Graph APPLICATION
# permission Mail.Send (admin consent granted). When all four are set, every
# HRMS email is sent from MICROSOFT_FROM_EMAIL via Graph and the SMTP_*
# settings are ignored. MICROSOFT_CLIENT_SECRET is the secret's VALUE, not
# its Secret ID. Set real values only in the untracked .env / secrets manager.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_FROM_EMAIL=info@impacgo.com
# Optional "on behalf of" sender (From = this address, sent through
# MICROSOFT_FROM_EMAIL). Needs Exchange: Set-Mailbox <this> -GrantSendOnBehalfTo
# <MICROSOFT_FROM_EMAIL>; until granted, mail goes from MICROSOFT_FROM_EMAIL
# with Reply-To this address.
MICROSOFT_ON_BEHALF_OF=
MICROSOFT_ON_BEHALF_OF_NAME=
# Optional: Reply-To for HRMS emails, and extra recipients (comma-separated)
# for every new leave application (e.g. the HR inbox).
EMAIL_REPLY_TO=
EMAIL_HR_RECIPIENTS=
# Test / staging safety net: only these recipient domains get email
# (comma-separated, e.g. impacgo.com). Blank = any domain when
# APP_ENV=production; in development mode blank means ONLY the sender
# mailbox's own domain (a dev server never mails demo / real employees of
# other domains by accident). "*" = any domain, explicitly.
# Dev/staging: use a separate dev mailbox (not the production M365 sender)
# and keep production credentials in a secrets manager, not in .env files.
EMAIL_ALLOWED_DOMAINS=
# Daily reminders (birthdays, work anniversaries, holidays): background job
# in the API process, from REMINDER_SEND_HOUR company time.
REMINDERS_ENABLED=true
REMINDER_SEND_HOUR=9
REMINDER_HOLIDAY_DAYS_BEFORE=1
REMINDER_POLL_MINUTES=15

# Legacy SMTP transport -- used only while the MICROSOFT_* settings above
# are blank (see app/email_service.py). Works with any standard SMTP provider -- fill in
# whichever one you use (Gmail/Google Workspace, Microsoft 365, SendGrid,
# Amazon SES, Mailgun, ...). Leave SMTP_HOST blank (or EMAIL_ENABLED=false)
# to disable email delivery entirely; in-app notifications keep working
# either way. Never commit real values here -- this file only documents
# the variable names.
#
# impacgo-solutions tenant is configured for Microsoft 365 (values below
# are the real M365 SMTP endpoint -- not secrets). SMTP_USERNAME is the
# full mailbox address; SMTP_PASSWORD must be that mailbox's password OR,
# if the account has MFA/Security Defaults enabled (the M365 default for
# every new tenant), an App Password generated for it instead -- a normal
# sign-in password will be rejected by SMTP AUTH in that case. The mailbox
# also needs "Authenticated SMTP" explicitly enabled -- see README/ops
# notes for the exact admin center steps. Never put the real password
# here; set it only in the untracked .env.
EMAIL_ENABLED=true
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=info@impacgo.com
SMTP_PASSWORD=change-me-to-the-mailbox-password-or-app-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM_ADDRESS=info@impacgo.com
EMAIL_FROM_NAME=Impacgo HRMS
# Base URL of the deployed Flutter web app -- used to build the "direct
# link to the relevant HRMS screen" inside notification emails.
FRONTEND_BASE_URL=http://localhost:8090
# Public URL of this API -- candidate offer-response / document-upload links
# emailed to candidates (no HRMS login), so it must be reachable from the
# internet. Leave blank to use FRONTEND_BASE_URL (nginx serves /api there).
PUBLIC_API_BASE_URL=

# API rate limiting (app/middleware/rate_limit.py) -- requests per minute.
# Per logged-in user, or per client IP when unauthenticated; login is always
# per IP. Limits are held in process memory, so each uvicorn worker counts
# separately. Set RATE_LIMIT_TRUST_PROXY=true only behind a reverse proxy
# that sets X-Forwarded-For.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_ANON_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SENSITIVE_PER_MINUTE=5
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_TRUST_PROXY=false

# DB pool + per-connection safety timeouts (PERF-04 / DB-03; ms, 0 disables)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# PDF rendering (FUNC-01 / P7)
PDF_BROWSER_STARTUP_CHECK=true
PDF_ALLOWED_ASSET_HOSTS=

# Approve / Reject buttons in approval emails (confirmation page, signed link, expires).
EMAIL_ACTIONS_ENABLED=false
EMAIL_ACTION_TTL_HOURS=72
# Public URL the email links point to (blank = FRONTEND_BASE_URL)
PUBLIC_API_BASE_URL=

# Breached-password check (Have I Been Pwned, k-anonymity) on every new /
# changed / reset password: only the first 5 hex characters of the password's
# SHA-1 are sent, never the password or full hash. Falls back to the bundled
# common-password list if the lookup fails. Set false without outbound internet.
PASSWORD_BREACH_CHECK_ENABLED=true
PASSWORD_BREACH_CHECK_TIMEOUT_SECONDS=2
